{
	"name": "TTC",
	"author": "kamarov",
	"version": "2.10.1",
	"manifest_version": 3,
	"description": "TTC - Dive into the retro mayhem once again!",
	"icons": {
		"128": "icon/icon128.png"
	},

	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "1",
				"enabled": true,
				"path": "assets/accessories.json"
			},
			{
				"id": "2",
				"enabled": true,
				"path": "assets/colours.json"
			},
			{
				"id": "3",
				"enabled": true,
				"path": "assets/game.json"
			},
			{
				"id": "4",
				"enabled": true,
				"path": "assets/garage.json"
			},
			{
				"id": "5",
				"enabled": true,
				"path": "assets/boxes.json"
			},
			{
				"id": "6",
				"enabled": true,
				"path": "assets/other.json"
			},
			{
				"id": "7",
				"enabled": true,
				"path": "assets/inputs.json"
			},
			{
				"id": "8",
				"enabled": true,
				"path": "assets/audio.json"
			},
			{
				"id": "9",
				"enabled": true,
				"path": "assets/tankInfo.json"
			},
			{
				"id": "10",
				"enabled": true,
				"path": "assets/forum.json"
			}
		]
	},

	"permissions": [
		"declarativeNetRequest",
		"declarativeNetRequestFeedback",
		"declarativeNetRequestWithHostAccess",
		"storage",
		"activeTab"
	],

	"host_permissions": [
		"*://*.tanktrouble.com/",
		"*://*.raw.githubusercontent.com/"
	],

	"content_scripts": [
		{
			"matches": ["*://*.tanktrouble.com/*"],
			"js": [
			 "ttc/utils/gameUtils.js",
			 "ttc/utils/timeUtils.js",
			 "ttc/scripts/pixi.js",
			 "ttc/scripts/patches.js",
			 "ttc/scripts/settingsAdditions.js",
			 "ttc/scripts/visitsSnippet.js",
			 "ttc/scripts/FAQSnippet.js",
			 "ttc/scripts/leaderboardSnippet.js",
			 "ttc/scripts/modActivitySnippet.js",
			 "ttc/scripts/tellAFriendSnippet.js",
			 "ttc/scripts/feedbackSnippet.js",
			 "ttc/scripts/gameIconLoader.js",
			 "ttc/scripts/tankIconLoader.js",
			 "ttc/scripts/chatMessageTranslation.js",
			 "ttc/scripts/tankWardrobe.js",
			 "ttc/scripts/forumAdditions.js",
			 "ttc/scripts/additionalPlayerDetails.js",
			 "ttc/scripts/UIConstants.js",
			 "ttc/scripts/UITankSprite.js",
			 "ttc/scripts/UIMineSprite.js",
			 "ttc/scripts/UIButtonGroup.js",
			 "ttc/scripts/UIScoreGroup.js",
			 "ttc/scripts/countdownImageLoader.js"
			],
			"css": ["ttc/css/style.css"],
			"run_at": "document_idle",
            "world": "MAIN"
		}
	],



	"web_accessible_resources": [{
		"resources": [
			"ttc/scripts/*.js",
			"ttc/utils/*.js",
			"assets/images/colours/*.png",
			"assets/audio/*.m4a",
			"assets/audio/*.mp3",
			"assets/images/accessories/*.png",
			"assets/images/boxes/*.png",
			"assets/images/buttons/*.png",
			"assets/images/header/*.png",
			"assets/images/forum/*.png",
			"assets/images/game/*.png",
			"assets/images/game/*.json",
			"assets/images/garage/*.png",
			"assets/images/tankIcon/*.png",
			"assets/images/tankInfo/*.png",
			"assets/images/other/*.png",
            "assets/images/inputs/*.png"
		],
		"matches": [ "*://*.tanktrouble.com/*" ]
	}]
}
